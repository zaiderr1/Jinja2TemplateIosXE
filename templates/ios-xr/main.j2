{#
  main.j2 (IOS-XR) - entry point, rendered once per device by generate.py
  when the OS column of the Generate sheet is ios-xr.
  Same data and same blocks as templates/ios-xe/. blocks.* comes from the
  VRF / Interfaces / BGP columns of the Generate sheet (empty = yes).
  No "end" or "commit" at the end on purpose: paste in configure mode,
  check with "show configuration", then commit yourself.
#}
{% if blocks.vrf %}
{% include 'vrf.j2' %}
{% endif %}
{% if blocks.interfaces %}
{% include 'interfaces.j2' %}
{% endif %}
{% if blocks.bgp %}
{% include 'bgp.j2' %}
{% endif %}
