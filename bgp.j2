{#
  bgp.j2 - BGP process, one address-family per VRF, one neighbor per link.
  local_as   BGP AS of this device
  router_id  optional (Router ID column of the Devices sheet)
  bgp_vrfs:  [{vrf, vpn_id, neighbors: [{ip, remote_as, device_b, description}]}]
    ip         IP of the other end of the link
    remote_as  BGP AS of the other end
    device_b   hostname of the other end (on either side of the link)
  Route-map naming standard:
    out: RP-BGP<local AS>OutBgp<remote AS>-<VRF>
    in:  RP-BGP<remote AS>InBgp<local AS>-<VRF>
  The route-maps themselves are not generated: they must exist on the device.
#}
router bgp {{ local_as }}
{% if router_id is defined %}
 bgp router-id {{ router_id }}
{% endif %}
{% for af in bgp_vrfs %}
 !
 address-family ipv4 vrf {{ af.vrf }}
  redistribute connected
{% for n in af.neighbors %}
  neighbor {{ n.ip }} remote-as {{ n.remote_as }}
  neighbor {{ n.ip }} description {{ n.device_b }}-(vrf {{ af.vrf }})
  neighbor {{ n.ip }} activate
  neighbor {{ n.ip }} route-map RP-BGP{{ local_as }}OutBgp{{ n.remote_as }}-{{ af.vrf }} out
  neighbor {{ n.ip }} route-map RP-BGP{{ n.remote_as }}InBgp{{ local_as }}-{{ af.vrf }} in
{% endfor %}
 exit-address-family
{% endfor %}
!
