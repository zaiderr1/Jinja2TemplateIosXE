{#
  bgp.j2 (IOS-XR) - BGP process, one VRF per VRF, one neighbor per link.
  local_as   BGP AS of this device
  router_id  optional (Router ID column of the Devices sheet)
  bgp_vrfs:  [{vrf, vpn_id, neighbors: [{ip, remote_as, device_b, description}]}]
  bgp_global: [{ip, remote_as, device_b, description}]  neighbors of GRT links
              (empty VRF cell): global "address-family ipv4 unicast", policies
              named with grt_label ("GRT"). No "redistribute connected" in the
              global table (it would reach every global BGP peer).
  Same naming standards as IOS-XE:
    RD:        <local AS>:<VPN ID>
    neighbor:  description <remote host>-(vrf <VRF>)
    policy in: RP-BGP<remote AS>InBgp<local AS>-<VRF>
    policy out: RP-BGP<local AS>OutBgp<remote AS>-<VRF>
  Differences with IOS-XE:
    - "address-family vpnv4 unicast" is required at the global level when the
      device has VRF neighbors, otherwise the VRF address-families are refused
      at commit. Likewise "address-family ipv4 unicast" for GRT neighbors.
    - the RD is set under "vrf <name>" here, not in the VRF definition.
    - route-policy (RPL) instead of route-map; there is no "activate".
    - eBGP sends and accepts no routes without a route-policy in AND out:
      the route-policies must exist on the device (they are not generated;
      generate.py lists them in the DEPENDENCIES block at the top of the config).
#}
router bgp {{ local_as }}
{% if router_id is defined %}
 bgp router-id {{ router_id }}
{% endif %}
{% if bgp_global %}
 address-family ipv4 unicast
 !
{% endif %}
{% if bgp_vrfs %}
 address-family vpnv4 unicast
 !
{% endif %}
{% for n in bgp_global %}
 neighbor {{ n.ip }}
  remote-as {{ n.remote_as }}
  description {{ n.description }}
  address-family ipv4 unicast
   route-policy RP-BGP{{ n.remote_as }}InBgp{{ local_as }}-{{ grt_label }} in
   route-policy RP-BGP{{ local_as }}OutBgp{{ n.remote_as }}-{{ grt_label }} out
  !
 !
{% endfor %}
{% for af in bgp_vrfs %}
 vrf {{ af.vrf }}
  rd {{ local_as }}:{{ af.vpn_id }}
  address-family ipv4 unicast
   redistribute connected
  !
{% for n in af.neighbors %}
  neighbor {{ n.ip }}
   remote-as {{ n.remote_as }}
   description {{ n.device_b }}-(vrf {{ af.vrf }})
   address-family ipv4 unicast
    route-policy RP-BGP{{ n.remote_as }}InBgp{{ local_as }}-{{ af.vrf }} in
    route-policy RP-BGP{{ local_as }}OutBgp{{ n.remote_as }}-{{ af.vrf }} out
   !
  !
{% endfor %}
 !
{% endfor %}
!
